# Copy to .env (or paste into your MCP client config) and fill in.
# At least one API key is required. Both are optional individually.

# Exa — https://dashboard.exa.ai/api-keys
EXA_API_KEY=

# DeepSeek — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Optional behaviour
# DEFAULT_SEARCH_PROVIDER=both        # both | exa | deepseek
# FETCH_PROVIDER_ORDER=exa,deepseek   # fallback order for fetch
# SEARCH_HTTP_TIMEOUT_MS=60000
# MERGE_DEDUPE=true
# EXA_BASE_URL=https://api.exa.ai
# DEEPSEEK_BASE_URL=https://api.deepseek.com
